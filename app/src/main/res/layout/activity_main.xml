<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="14dp" android:paddingBottom="16dp" android:background="@color/bg" android:layoutDirection="rtl">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="محاسبه‌گر Stop Loss / Take Profit" android:textSize="24sp" android:textStyle="bold"
        android:textColor="@color/text" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="6dp"/>
    <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="محاسبه سریع و دقیق معامله" android:textSize="13sp" android:textColor="@color/muted"
        android:gravity="center" android:layout_marginBottom="14dp"/>
    <FrameLayout android:id="@+id/container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/nextButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:text="بعد" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF"
        android:background="@drawable/bg_button" android:textAllCaps="false" android:layout_marginTop="12dp"/>
</LinearLayout>
